{
  "manifest_version": 3,
  "name": "reCAPTCHA VLM Solver",
  "version": "0.1.0",
  "description": "调用本地 recaptcha_vlm 服务自动求解 Google reCAPTCHA 图片挑战",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.google.com/recaptcha/*",
    "https://*.google.com/recaptcha/*",
    "https://*.gstatic.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "reCAPTCHA VLM Solver"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/recaptcha/*",
        "https://*.google.com/recaptcha/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
