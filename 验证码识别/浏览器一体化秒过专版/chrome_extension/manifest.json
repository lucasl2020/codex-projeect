{
  "manifest_version": 3,
  "name": "本地离线验证码自动通过 (Local Captcha Auto-Pass)",
  "version": "1.0.0",
  "description": "基于本机离线视觉大模型与机器视觉，自动识别并秒过 Google reCAPTCHA、hCaptcha 与 Cloudflare Turnstile 验证码",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "本地离线验证码助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
